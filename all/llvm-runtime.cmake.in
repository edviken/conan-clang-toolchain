include_guard(GLOBAL)

set(LLVM_TOOLCHAIN_RUNTIME_DIR "${CMAKE_CURRENT_LIST_DIR}/@LLVM_RUNTIME_LIBDIR@")
list(APPEND CMAKE_BUILD_RPATH "${LLVM_TOOLCHAIN_RUNTIME_DIR}")
list(REMOVE_DUPLICATES CMAKE_BUILD_RPATH)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CMAKE_BUILD_RPATH)

if(NOT DEFINED CMAKE_INSTALL_RPATH)
    set(CMAKE_INSTALL_RPATH "@LLVM_RUNTIME_ORIGIN@;@LLVM_RUNTIME_ORIGIN@/../lib")
endif()
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)

function(llvm_toolchain_install_runtimes)
    foreach(runtime IN ITEMS @LLVM_RUNTIME_NAMES@)
        # Install real files under their Mach-O install names / ELF SONAMEs.
        get_filename_component(file "${LLVM_TOOLCHAIN_RUNTIME_DIR}/${runtime}" REALPATH)
        install(FILES "${file}" DESTINATION lib RENAME "${runtime}")
    endforeach()
endfunction()
